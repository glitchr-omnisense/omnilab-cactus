parameters:
	ignoreErrors:
		-
			message: '#^Method Omnilab\\Cactus\\CactusSource\:\:opsin\(\) should return array\<string, mixed\>\|null but returns array\|null\.$#'
			identifier: return.type
			count: 1
			path: CactusSource.php

		-
			message: '#^Parameter \#2 \$value of static method Omnilab\\Model\\Identifier\:\:tryOf\(\) expects int\|string\|null, mixed given\.$#'
			identifier: argument.type
			count: 3
			path: CactusSource.php

		-
			message: '#^Parameter \#3 \$value of class Omnilab\\Model\\Property constructor expects bool\|float\|int\|Omnilab\\Model\\Quantity\|string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: CactusSource.php

		-
			message: '#^Cannot cast mixed to float\.$#'
			identifier: cast.double
			count: 1
			path: CactusSourceFactory.php

		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 1
			path: CactusSourceFactory.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: CactusSourceFactory.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, ''strval'' given\.$#'
			identifier: argument.type
			count: 1
			path: CactusSourceFactory.php

		-
			message: '#^Cannot access property \$domain on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CactusSourceTest.php

		-
			message: '#^Cannot access property \$id on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 4
			path: Tests/CactusSourceTest.php

		-
			message: '#^Cannot access property \$identifiers on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 4
			path: Tests/CactusSourceTest.php

		-
			message: '#^Cannot access property \$image on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 2
			path: Tests/CactusSourceTest.php

		-
			message: '#^Cannot access property \$kind on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CactusSourceTest.php

		-
			message: '#^Cannot access property \$label on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 5
			path: Tests/CactusSourceTest.php

		-
			message: '#^Cannot access property \$synonyms on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 3
			path: Tests/CactusSourceTest.php

		-
			message: '#^Cannot call method identifier\(\) on Omnilab\\Model\\Entity\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/CactusSourceTest.php

		-
			message: '#^Cannot call method properties\(\) on Omnilab\\Model\\Entity\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/CactusSourceTest.php

		-
			message: '#^Cannot call method value\(\) on Omnilab\\Model\\Entity\|null\.$#'
			identifier: method.nonObject
			count: 14
			path: Tests/CactusSourceTest.php

		-
			message: '#^Method Omnilab\\Cactus\\Tests\\CactusSourceTest\:\:source\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/CactusSourceTest.php

		-
			message: '#^Offset 0 does not exist on array\{\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: Tests/CactusSourceTest.php

		-
			message: '#^Parameter \#1 \$options of method Omnilab\\Source\\SourceFactory\:\:create\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/CactusSourceTest.php

		-
			message: '#^Parameter \#3 \$length of function substr expects int\|null, int\|false given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/CactusSourceTest.php
